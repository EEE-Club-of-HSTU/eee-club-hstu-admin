rules_version = '2';

// Shared by the public site (eee-club-hstu) and the admin app (eee-club-hstu-admin).
// Contract: firebase/SCHEMA.md
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function reqStr(d, k, max) {
      return k in d && d[k] is string && d[k].size() > 0 && d[k].size() <= max;
    }

    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function validEmail(d, k) {
      return reqStr(d, k, 200) && d[k].matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Shape checks for admin writes, so a bad edit can't break the public site.
    function validEvent(d) {
      return reqStr(d, 'title', 160)
        && d.type in ['workshop', 'competition', 'seminar', 'trip', 'outreach']
        && reqStr(d, 'startsAt', 40)
        && optStr(d, 'endsAt', 40)
        && reqStr(d, 'venue', 160)
        && optStr(d, 'summary', 600)
        && optStr(d, 'link', 300)
        && d.featured is bool
        && d.published is bool;
    }

    function validNotice(d) {
      return reqStr(d, 'title', 200)
        && reqStr(d, 'body', 1000)
        && d.category in ['general', 'events', 'lab', 'publication', 'alumni']
        && reqStr(d, 'noticeDate', 10)
        && optStr(d, 'link', 300)
        && d.pinned is bool
        && d.published is bool;
    }

    function validCertificate(d) {
      return reqStr(d, 'type', 120)
        && reqStr(d, 'name', 160)
        && reqStr(d, 'details', 300)
        && reqStr(d, 'issuedOn', 10)
        && d.status in ['valid', 'revoked'];
    }

    // Published content: the public reads published documents, admins do everything.
    match /event_logs/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /notices/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validNotice(request.resource.data);
      allow delete: if isAdmin();
    }

    // Looked up one at a time by certificate ID; never listable by the public.
    match /certificates/{certId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validCertificate(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- Admin-managed content: public reads published docs only ----
    function published() {
      return resource.data.published == true;
    }

    function hasPublishedFlag(d) {
      return d.published is bool;
    }

    match /blogs/{id} {
      allow read: if published() || isAdmin();
      allow create, update: if isAdmin() && hasPublishedFlag(request.resource.data)
        && reqStr(request.resource.data, 'title', 200)
        && reqStr(request.resource.data, 'content', 60000)
        && request.resource.data.tag in ['tutorial', 'recap', 'research', 'career', 'opinion', 'news'];
      allow delete: if isAdmin();
    }

    match /leadership_members/{id} {
      allow read: if published() || isAdmin();
      allow create, update: if isAdmin() && hasPublishedFlag(request.resource.data)
        && reqStr(request.resource.data, 'name', 160)
        && request.resource.data.category in ['executive', 'alumni', 'advisory', 'taskforce']
        && request.resource.data.order is int;
      allow delete: if isAdmin();
    }

    match /gallery_items/{id} {
      allow read: if published() || isAdmin();
      allow create, update: if isAdmin() && hasPublishedFlag(request.resource.data)
        && reqStr(request.resource.data, 'imageUrl', 500)
        && request.resource.data.category in ['competition', 'workshop', 'trip', 'people', 'other'];
      allow delete: if isAdmin();
    }

    match /magazines/{id} {
      allow read: if published() || isAdmin();
      allow create, update: if isAdmin() && hasPublishedFlag(request.resource.data)
        && request.resource.data.issueNumber is int
        && reqStr(request.resource.data, 'title', 160);
      allow delete: if isAdmin();
    }

    match /resources/{id} {
      allow read: if published() || isAdmin();
      allow create, update: if isAdmin() && hasPublishedFlag(request.resource.data)
        && reqStr(request.resource.data, 'title', 200)
        && reqStr(request.resource.data, 'url', 500)
        && request.resource.data.kind in ['notes', 'lab', 'code', 'exam', 'other'];
      allow delete: if isAdmin();
    }

    match /faqs/{id} {
      allow read: if published() || isAdmin();
      allow create, update: if isAdmin() && hasPublishedFlag(request.resource.data)
        && reqStr(request.resource.data, 'question', 300)
        && reqStr(request.resource.data, 'answer', 3000);
      allow delete: if isAdmin();
    }

    match /partners/{id} {
      allow read: if published() || isAdmin();
      allow create, update: if isAdmin() && hasPublishedFlag(request.resource.data)
        && reqStr(request.resource.data, 'name', 160);
      allow delete: if isAdmin();
    }

    // Singletons: anyone can read, admins write.
    match /pages_static/{pageId} {
      allow read: if pageId in ['constitution', 'history', 'privacy', 'terms'];
      allow write: if isAdmin() && pageId in ['constitution', 'history', 'privacy', 'terms']
        && (request.method == 'delete'
            || (reqStr(request.resource.data, 'title', 200) && reqStr(request.resource.data, 'content', 100000)));
    }

    match /site_settings/{docId} {
      allow read: if docId in ['footer', 'location'];
      allow write: if isAdmin() && docId in ['footer', 'location'];
    }

    match /alumni_registrations/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'fullName', 'session', 'graduationYear', 'email', 'studentId', 'phone',
          'currentRole', 'organization', 'city', 'linkedin', 'interests', 'message',
          'consent', 'status', 'source', 'createdAt'
        ])
        && reqStr(request.resource.data, 'fullName', 120)
        && reqStr(request.resource.data, 'session', 20)
        && request.resource.data.graduationYear is int
        && request.resource.data.graduationYear >= 2000
        && request.resource.data.graduationYear <= 2100
        && validEmail(request.resource.data, 'email')
        && optStr(request.resource.data, 'studentId', 40)
        && optStr(request.resource.data, 'phone', 40)
        && optStr(request.resource.data, 'currentRole', 120)
        && optStr(request.resource.data, 'organization', 160)
        && optStr(request.resource.data, 'city', 80)
        && optStr(request.resource.data, 'linkedin', 300)
        && optStr(request.resource.data, 'message', 2000)
        && (!('interests' in request.resource.data)
            || (request.resource.data.interests is list
                && request.resource.data.interests.size() <= 6
                && request.resource.data.interests.hasOnly(['mentoring', 'guest_talks', 'hiring', 'donations', 'events', 'research'])))
        && (!('source' in request.resource.data) || request.resource.data.source == 'website')
        && request.resource.data.consent == true
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'organization', 'topic', 'message', 'status', 'createdAt'])
        && reqStr(request.resource.data, 'name', 120)
        && validEmail(request.resource.data, 'email')
        && optStr(request.resource.data, 'organization', 160)
        && request.resource.data.topic in ['general', 'partnership', 'alumni', 'media', 'sponsorship']
        && reqStr(request.resource.data, 'message', 4000)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && validEmail(request.resource.data, 'email')
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
